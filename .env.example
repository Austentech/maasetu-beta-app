# MaaSetu — Environment Variables Template
# ============================================================
# Copy the relevant blocks to the files below. NEVER commit
# real secret values (see docs/SECURITY.md).
#
#   apps/api/.env        → backend (NestJS) variables
#   apps/web/.env.local  → frontend (Next.js) variables
#
# Phase 1 needs only the API block. The web app requires no
# environment variables until authentication is implemented.

# ────────────────────────────────────────────────────────────
# apps/api (NestJS) — copy to apps/api/.env
# ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Comma-separated allowlist of browser origins allowed to call
# the API. Keep this list tight in every environment.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ────────────────────────────────────────────────────────────
# Future — Supabase (NOT USED in Phase 1 — leave empty)
# ────────────────────────────────────────────────────────────
# Supabase Auth will manage identity. These keys document the
# future shape only. The owner must supply the real project
# configuration; never invent or commit working keys.
#
# Browser-safe (apps/web/.env.local):
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
#
# Server-only (apps/api/.env — MUST NEVER reach the browser):
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
